# Copy to .env and adjust as needed. docker-compose and every service read
# their config from environment variables (12-factor) so local, CI, and any
# future real deployment share the same code path.

# --- Redpanda / Kafka ---
KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC_RAW_EVENTS=raw-events
KAFKA_TOPIC_FEATURES=features
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_MODEL_METRICS=model-metrics
KAFKA_TOPIC_PARTITIONS=6

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=risk
CLICKHOUSE_USER=default
# Dev-only credential for a network that isn't exposed beyond the local
# docker-compose bridge. Change if you expose ClickHouse beyond localhost.
CLICKHOUSE_PASSWORD=risk_dev_only

# --- data-generator ---
DATA_GENERATOR_WS_PORT=8765
DATA_GENERATOR_EVENTS_PER_SEC=200
# ~7% steady-state anomalous duty cycle, not 7% spawn chance — see the
# comment on Settings.scenario_probability in app/config.py for the math.
DATA_GENERATOR_SCENARIO_PROBABILITY=0.002

# --- ingestion ---
INGESTION_WS_URL=ws://data-generator:8765/stream
INGESTION_METRICS_PORT=9101

# --- feature-service ---
FEATURE_SERVICE_METRICS_PORT=9102
FEATURE_WINDOW_MARKET_S=2
FEATURE_WINDOW_PAYMENTS_S=5
FEATURE_EWMA_ALPHA=0.1

# --- ml-inference ---
# NB: field names below map 1:1 to Settings in services/ml-inference/app/config.py
# Port 8010, not 8000: a common enough dev-tool default to collide with
# something else already running on a real workstation.
ML_INFERENCE_HTTP_PORT=8010
ANOMALY_WATCH_THRESHOLD=0.55
ANOMALY_ALERT_THRESHOLD=0.75
ANOMALY_CRITICAL_THRESHOLD=0.90
DRIFT_CHECK_INTERVAL_S=30

# --- api-gateway ---
# Port 8180, not 8080, for the same reason.
API_GATEWAY_HTTP_PORT=8180
# Shared secret an operator exchanges at POST /auth/token for a short-lived
# JWT; required to call control-plane endpoints like /api/scenarios/inject
# (see docs/roadmap.md "Auth: none -> everything"). Read-only endpoints
# (alerts, model metrics, dashboard data) stay unauthenticated on purpose -
# the RBAC boundary here is "who can act", not "who can look".
API_GATEWAY_OPERATOR_API_KEY=risk_dev_operator_key_change_me
# HMAC signing secret for issued JWTs. Change this for anything beyond local
# dev — if left unset the service falls back to a random secret generated at
# startup (logged loudly), which works but invalidates every token on restart.
API_GATEWAY_JWT_SECRET=risk_dev_jwt_signing_secret_change_me_1234567890
API_GATEWAY_JWT_EXPIRY_MINUTES=60

# --- dashboard ---
DASHBOARD_PORT=5173
VITE_API_BASE_URL=http://localhost:8180
VITE_WS_URL=ws://localhost:8180/ws

# --- observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
REDPANDA_CONSOLE_PORT=8090
