{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://real-time-risk/schemas/alert_event.schema.json",
  "title": "AlertEvent",
  "type": "object",
  "required": [
    "alert_id", "entity_key", "domain", "ts", "window_end", "anomaly_score",
    "severity", "action", "detectors", "explanation", "model_version",
    "drift_flag", "latency_ingest_to_alert_ms"
  ],
  "properties": {
    "alert_id": { "type": "string", "format": "uuid" },
    "entity_key": { "type": "string" },
    "domain": { "type": "string", "enum": ["market", "payments"] },
    "ts": { "type": "string", "format": "date-time" },
    "window_end": { "type": "string", "format": "date-time" },
    "anomaly_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "severity": { "type": "string", "enum": ["watch", "alert", "critical"] },
    "action": { "type": "string", "enum": ["watch", "alert", "block"] },
    "detectors": {
      "type": "object",
      "required": ["zscore", "ewma", "cusum", "isolation_forest", "autoencoder"],
      "properties": {
        "zscore": { "type": "number" },
        "ewma": { "type": "number" },
        "cusum": { "type": "number" },
        "isolation_forest": { "type": "number" },
        "autoencoder": { "type": "number" },
        "xgboost": { "type": ["number", "null"] }
      }
    },
    "explanation": {
      "type": "object",
      "required": ["probable_cause", "top_features"],
      "properties": {
        "probable_cause": {
          "type": "string",
          "enum": ["volatility_spike", "latency_incident", "fraud_pattern", "data_corruption", "regime_change", "volume_spike", "unknown"]
        },
        "top_features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["feature", "value", "baseline", "contribution"],
            "properties": {
              "feature": { "type": "string" },
              "value": { "type": "number" },
              "baseline": { "type": "number" },
              "contribution": { "type": "number" }
            }
          }
        }
      }
    },
    "model_version": { "type": "string" },
    "drift_flag": { "type": "boolean" },
    "latency_ingest_to_alert_ms": { "type": "number" }
  }
}
