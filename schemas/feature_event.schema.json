{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://real-time-risk/schemas/feature_event.schema.json",
  "title": "FeatureEvent",
  "type": "object",
  "required": [
    "entity_key", "domain", "window_start", "window_end", "window_size_s", "count", "throughput_eps",
    "latency_p50_ms", "latency_p99_ms", "error_rate",
    "ewma_mean", "ewma_var", "zscore", "primary_metric"
  ],
  "properties": {
    "entity_key": { "type": "string" },
    "domain": { "type": "string", "enum": ["market", "payments"] },
    "window_start": { "type": "string", "format": "date-time" },
    "window_end": { "type": "string", "format": "date-time" },
    "window_size_s": { "type": "number" },
    "count": { "type": "integer", "minimum": 0 },
    "throughput_eps": { "type": "number" },
    "latency_p50_ms": { "type": "number" },
    "latency_p99_ms": { "type": "number" },
    "error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "vwap": { "type": ["number", "null"] },
    "spread_bps": { "type": ["number", "null"] },
    "realized_vol": { "type": ["number", "null"] },
    "order_imbalance": { "type": ["number", "null"] },
    "mean_amount": { "type": ["number", "null"] },
    "sum_amount": { "type": ["number", "null"] },
    "decline_rate": { "type": ["number", "null"] },
    "distinct_accounts": { "type": ["integer", "null"] },
    "ewma_mean": { "type": "number" },
    "ewma_var": { "type": "number" },
    "zscore": { "type": "number" },
    "primary_metric": { "type": "number" }
  }
}
